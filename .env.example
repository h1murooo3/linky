############################
# Database
############################
# В Docker в compose подставляется свой URL; в .env важно не резать хвост:
# после :5432/ всегда имя БД (POSTGRES_DB), не пользователь. Иначе клиент
# подставит имя пользователя как имя базы → "database linky_user does not exist".
DATABASE_URL=postgresql://linky_user:linky_password@db:5432/linky_db
POSTGRES_USER=linky_user
POSTGRES_PASSWORD=linky_password
POSTGRES_DB=linky_db

############################
# Redis
############################
REDIS_URL=redis://redis:6379/0

############################
# Security
############################
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

############################
# API
############################
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

############################
# Scraping
############################
USER_AGENT_ROTATION=true
REQUEST_DELAY=2
MAX_RETRIES=3
PROXY_ENABLED=false
# api.hh.ru: 160 — Алматы (см. справочник /areas)
HH_DEFAULT_AREA=160
HH_DEFAULT_SEARCH_TEXT=IT
HH_IMPORT_PAGES=3
LINKEDIN_GUEST_KEYWORDS=IT
LINKEDIN_GUEST_LOCATION=Almaty, Kazakhstan
LINKEDIN_GUEST_REQUIRE_ALMATY_LOCATION=true
LINKY_SYNC_ON_START=true

############################
# Monitoring
############################
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO

